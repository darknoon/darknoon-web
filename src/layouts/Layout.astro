---
import '../styles/colors.css';
import '../styles/fonts.css';
import '../styles/theme.css';
import '../styles/layout.css';
interface Props { title?: string }
const { title } = Astro.props;
const pageTitle = title ? `${title} — Andrew Pouliot` : 'Andrew Pouliot';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal page for Andrew Pouliot" />
    <meta name="keywords" content="machine learning, AI, ML, React, node, iOS, UI" />
    <meta name="theme-color" content="#663399" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main style="margin: 0 auto; padding: 1rem; max-width: 960px;">
      <header><a href="/" style="text-decoration: none;"><h3>Andrew Pouliot</h3></a></header>
      <slot />
    </main>
  </body>
</html>
<style is:global>
  /* The old Gatsby image wrappers handled these dimensions. */
  .post-content img { height: auto; }
  .post-content p > img, .post-content .article-image-link img { display: block; margin: 0 auto; }
  .post-content pre { max-width: 100%; }
</style>
