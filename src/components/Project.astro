---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { project: { key: string; title: string; what: string; link?: string; mediaURL?: string; videoURL?: string; with?: { name: string; href: string } } }
const { project: p } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/**/*.png', { eager: true });
const image = p.mediaURL ? images[`../assets/${p.mediaURL}`]?.default : undefined;
if (p.mediaURL && !image) throw new Error(`Missing project image: ${p.mediaURL}`);
const video = p.videoURL?.includes('vimeo.com') ? `${p.videoURL}?color=fff&title=0&byline=0&portrait=0` : p.videoURL;
---
<section id={p.key}>
  <a href={p.link}><h3>{p.title}</h3></a>
  <p>{p.what}</p>
  {p.with && <p>with <a href={p.with.href}>{p.with.name}</a></p>}
  {image && <div class="project-image"><a href={p.link}><Image src={image} alt={p.title} width={744} widths={[372, 744, 1488]} sizes="(min-width: 960px) 744px, (min-width: 500px) calc(100vw - 216px), calc(100vw - 32px)" /></a></div>}
  {video && <div class="gatsby-resp-iframe-wrapper" style="padding-bottom: 56.25%; position: relative; height: 0; overflow: hidden; background: black;">
    <iframe title={p.title} width="560" height="315" src={video} allow="autoplay; encrypted-media" allowfullscreen style="border: 0; position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></iframe>
  </div>}
</section>
<style>.project-image img { display: block; width: 100%; height: auto; margin: 0; }</style>
