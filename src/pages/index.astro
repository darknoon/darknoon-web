---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/resources/wubba-lubba-dub-dub.jpg';

// Selected work, rather than a complete archive.
const selectedWork = [
  { year: 2026, items: [
    { name: 'Fieldwork', href: 'https://fieldwork.software/' },
  ] },
  { year: 2024, items: [
    { name: 'Prefix Canvas', href: 'https://canvas.prefix.design/files/Colored%20Boxes' },
  ] },
  { year: 2022, items: [
    { name: 'Diagram', href: 'https://diagram.com/' },
  ] },
  { year: 2020, items: [
    { name: 'GAN bending', href: '/2020/03/03/gan-hacking/' },
  ] },
  { year: 2019, items: [
    { name: 'Statue of Liberty official app', href: 'https://apps.apple.com/us/story/id1464767766' },
  ] },
  { year: 2018, items: [
    { name: 'Flower Petals', href: '/projects/#meyohas-petals' },
  ] },
  { year: 2016, items: [
    { name: 'Origami Studio', href: 'https://origami.design' },
  ] },
  { year: 2014, items: [
    { name: 'Facebook Paper', href: 'https://www.youtube.com/watch?v=Zq6-b9_V9lA' },
  ] },
];
---
<Layout>
  <div class="portrait"><Image src={portrait} alt="Andrew Pouliot" width={300} widths={[300, 600]} sizes="300px" loading="eager" quality={90} /></div>
  <div class="home-copy">
    <p>I'm teaching artificial minds how to design</p>
    <nav class="selected-work" aria-label="Selected work by year">
      <ul>
        {selectedWork.flatMap(({ year, items }) => items.map(({ name, href }) => (
          <li><a href={href}><span class="year">{year}</span><span class="link-name">{name}</span></a></li>
        )))}
      </ul>
      <a class="more" href="/old/">More</a>
    </nav>
  </div>
</Layout>
<style>
  .portrait { position: relative; }
  .portrait img { margin: 0; width: 300px; height: auto; border-radius: 30px; }
  .home-copy > p { margin-top: 1rem; max-width: 44rem; }
  .selected-work { margin-top: 2rem; padding-bottom: 2rem; }
  .selected-work ul { list-style: none; margin: 0; padding: 0; }
  .selected-work li { margin: 0; }
  .selected-work a { position: relative; color: inherit; display: inline-flex; align-items: baseline; padding: 0.2rem 0; text-decoration: none; }
  .selected-work a:hover .link-name, .selected-work .more:hover { text-decoration: underline; }
  .selected-work a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .year { flex: 0 0 3rem; margin-left: -4rem; margin-right: 1rem; text-align: right; font-size: 0.8rem; font-variant-numeric: tabular-nums; opacity: 0; pointer-events: none; }
  a:hover .year, a:focus-visible .year { opacity: 0.5; }
  .more { margin-top: 1rem; }
  @media (max-width: 1100px) {
    .selected-work { padding-left: 3.5rem; }
  }
</style>
