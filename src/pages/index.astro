---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/resources/wubba-lubba-dub-dub.jpg';

// Selected work, split into professional work and personal/fun projects.
const sections = [
  { label: null, items: [
    { year: 2026, name: 'Fieldwork', href: 'https://fieldwork.software/', current: true },
    { year: 2024, name: 'Prefix Canvas', href: 'https://canvas.prefix.design/files/Colored%20Boxes' },
    { year: 2022, name: 'Diagram', href: 'https://www.figma.com/blog/ai-the-next-chapter-in-design/' },
    { year: 2017, name: 'Lobe', href: 'https://lobe.ai/' },
    { year: 2016, name: 'Origami Studio', href: 'https://origami.design' },
    { year: 2014, name: 'Facebook Paper', href: 'https://www.youtube.com/watch?v=Zq6-b9_V9lA' },
  ] },
  { label: 'Fun', items: [
    { year: 2026, name: 'Drawing Room', href: 'https://brush.tips/' },
    { year: 2020, name: 'GAN bending', href: '/2020/03/03/gan-hacking/' },
    { year: 2019, name: 'Statue of Liberty official app', href: 'https://apps.apple.com/us/story/id1464767766' },
    { year: 2018, name: 'Flower Petals', href: '/projects/#meyohas-petals' },
  ] },
];
---
<Layout>
  <div class="portrait"><Image src={portrait} alt="Andrew Pouliot" width={300} widths={[300, 600]} sizes="300px" loading="eager" quality={90} /></div>
  <div class="home-copy">
    <p>I'm teaching artificial minds how to design</p>
    {sections.map(({ label, items }) => (
      <section class="group">
        {label && <h2 class="group-label">{label}</h2>}
        <nav class="group-list" aria-label={label ?? 'Selected work'}>
          <ul>
            {items.map(({ year, name, href, current }) => (
              <li><a href={href}><span class="year">{year}</span>{current && <span class="dot" aria-hidden="true"></span>}<span class="link-name">{name}</span>{current && <span class="sr-only">(current)</span>}</a></li>
            ))}
          </ul>
        </nav>
      </section>
    ))}
    <a class="more" href="/old/">Writing</a>
  </div>
</Layout>
<style>
  .portrait { position: relative; }
  .portrait img { margin: 0; width: 300px; height: auto; border-radius: 30px; }
  .home-copy > p { margin-top: 1rem; max-width: 44rem; }
  .group { margin-top: 2rem; }
  .group-label { margin: 0 0 0.2rem; font-size: inherit; font-weight: normal; color: var(--text-muted); }
  .group-list ul { list-style: none; margin: 0; padding: 0; }
  .group-list li { margin: 0; }
  .group-list a { position: relative; color: inherit; display: inline-flex; align-items: baseline; padding: 0.2rem 0; text-decoration: none; }
  .group-list a:hover .link-name { text-decoration: underline; }
  .group-list a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .dot { position: absolute; left: -0.8rem; top: 50%; transform: translateY(-50%); width: 0.4rem; height: 0.4rem; border-radius: 50%; background: currentColor; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .year { flex: 0 0 3rem; margin-left: -4rem; margin-right: 1rem; text-align: right; font-size: 0.8rem; font-variant-numeric: tabular-nums; opacity: 0; pointer-events: none; }
  a:hover .year, a:focus-visible .year { opacity: 0.5; }
  .more { display: inline-block; margin-top: 2rem; padding-bottom: 2rem; color: var(--text-muted); text-decoration: none; }
  @media (max-width: 1100px) {
    .group { padding-left: 3.5rem; }
  }
</style>
