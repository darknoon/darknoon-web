---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/resources/wubba-lubba-dub-dub.jpg';

// Selected work, split into professional work and personal/fun projects.
type WorkItem = { year: number; name: string; href: string; current?: boolean };
const sections: { label: string | null; items: WorkItem[] }[] = [
  { label: null, items: [
    { year: 2026, name: 'Fieldwork', href: 'https://fieldwork.software/', current: true },
    { year: 2024, name: 'Prefix Canvas', href: 'https://canvas.prefix.design/files/Colored%20Boxes' },
    { year: 2022, name: 'Diagram', href: 'https://www.figma.com/blog/ai-the-next-chapter-in-design/' },
    { year: 2017, name: 'Lobe', href: 'https://lobe.ai/' },
    { year: 2016, name: 'Origami Studio', href: 'https://origami.design' },
    { year: 2014, name: 'Facebook Paper', href: 'https://www.youtube.com/watch?v=Zq6-b9_V9lA' },
  ] },
  { label: 'Fun', items: [
    { year: 2026, name: 'Drawing Room', href: 'https://brush.tips/' },
    { year: 2020, name: 'GAN bending', href: '/2020/03/03/gan-hacking/' },
    { year: 2019, name: 'Statue of Liberty official app', href: 'https://apps.apple.com/us/story/id1464767766' },
    { year: 2018, name: 'Flower Petals', href: '/projects/#meyohas-petals' },
  ] },
];
---
<Layout>
  <div class="portrait"><Image src={portrait} alt="Andrew Pouliot" width={300} widths={[300, 600]} sizes="300px" loading="eager" quality={90} /></div>
  <div class="home-copy">
    <p>I'm teaching artificial minds how to design</p>
    {sections.map(({ label, items }) => (
      <section class="group">
        {label && <h2 class="sr-only">{label}</h2>}
        <nav class="group-list" aria-label={label ?? 'Selected work'}>
          <ul>
            {items.map(({ year, name, href, current }) => (
              <li><a href={href}><span class="year">{year}</span><span class="link-name">{name}</span>{current && <span class="dot" aria-hidden="true"></span>}{current && <span class="sr-only">(current)</span>}</a></li>
            ))}
          </ul>
        </nav>
      </section>
    ))}
    <a class="more" href="/old/">Writing</a>
    {import.meta.env.DEV && (
      <div class="beat-tuner" role="group" aria-label="Dot animation">
        <label for="beat-mode">Motion</label>
        <select id="beat-mode">
          <option value="breathe">Breathe</option>
          <option value="heartbeat">Heartbeat</option>
        </select>
        <label for="beat-strength">Strength</label>
        <input id="beat-strength" type="range" min="0" max="0.8" step="0.01" value="0.18" />
        <output id="beat-strength-value" for="beat-strength">0.18</output>
      </div>
    )}
  </div>
</Layout>
<script>
  type Mode = 'breathe' | 'heartbeat';
  const modeSelect = document.getElementById('beat-mode');
  const slider = document.getElementById('beat-strength');
  const readout = document.getElementById('beat-strength-value');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.dot'));

  const specs: Record<Mode, { duration: number; easing: string; frames: (v: number) => Keyframe[] }> = {
    breathe: {
      duration: 3600,
      easing: 'ease-in-out',
      frames: (v) => [
        { transform: 'scale(1)', offset: 0 },
        { transform: `scale(${1 + v})`, offset: 0.5 },
        { transform: 'scale(1)', offset: 1 },
      ],
    },
    heartbeat: {
      duration: 1400,
      easing: 'ease-in-out',
      frames: (v) => [
        { transform: 'scale(1)', offset: 0 },
        { transform: `scale(${1 + v})`, offset: 0.12 },
        { transform: `scale(${1 + v * 0.08})`, offset: 0.34 },
        { transform: `scale(${1 + v * 0.5})`, offset: 0.46 },
        { transform: 'scale(1)', offset: 0.68 },
        { transform: 'scale(1)', offset: 1 },
      ],
    },
  };

  if (slider instanceof HTMLInputElement && readout && dots.length > 0) {
    const apply = () => {
      const value = Number(slider.value);
      readout.textContent = value.toFixed(2);
      const mode: Mode =
        modeSelect instanceof HTMLSelectElement && modeSelect.value === 'heartbeat'
          ? 'heartbeat'
          : 'breathe';
      const spec = specs[mode];
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      for (const dot of dots) {
        dot.style.animation = 'none';
        for (const animation of dot.getAnimations()) animation.cancel();
        if (value > 0 && !reduced) {
          dot.animate(spec.frames(value), {
            duration: spec.duration,
            iterations: Infinity,
            easing: spec.easing,
          });
        }
      }
    };
    slider.addEventListener('input', apply);
    if (modeSelect) modeSelect.addEventListener('change', apply);
    apply();
  }
</script>
<style>
  .portrait { position: relative; }
  .portrait img { margin: 0; width: 300px; height: auto; border-radius: 30px; }
  .home-copy > p { margin-top: 1rem; max-width: 44rem; }
  .group { margin-top: 2rem; }
  .group-list ul { list-style: none; margin: 0; padding: 0; }
  .group-list li { margin: 0; }
  .group-list a { position: relative; color: inherit; display: inline-flex; align-items: baseline; padding: 0.2rem 0; text-decoration: none; }
  .group-list a:hover .link-name, .group-list a:focus-visible .link-name { color: var(--accent-1); }
  .group-list a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .dot { align-self: center; position: relative; top: 0.06rem; flex: none; width: 0.4rem; height: 0.4rem; aspect-ratio: 1; border-radius: 50%; background: currentColor; margin-left: 0.38rem; transform-origin: 50% 50%; animation: heartbeat 1.05s cubic-bezier(0.22, 0.61, 0.36, 1) infinite; }
  .beat-tuner { position: fixed; right: 1rem; bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.75rem; border: 1px solid color-mix(in srgb, var(--text-muted) 40%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--background) 88%, var(--text) 12%); color: var(--text-muted); font-size: 0.8rem; z-index: 10; }
  .beat-tuner input { width: 8rem; }
  .beat-tuner select { font: inherit; color: inherit; background: transparent; border: 1px solid color-mix(in srgb, var(--text-muted) 40%, transparent); border-radius: 6px; padding: 0.1rem 0.25rem; }
  .beat-tuner output { min-width: 2.2rem; text-align: right; font-variant-numeric: tabular-nums; }
  :global(:root) { --beat: 0.18; }
  @keyframes heartbeat {
    0% { transform: scale(1); }
    8% { transform: scale(calc(1 + var(--beat))); }
    16% { transform: scale(calc(1 - var(--beat) * 0.06)); }
    24% { transform: scale(calc(1 + var(--beat) * 0.5)); }
    32% { transform: scale(1); }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .year { position: absolute; top: 50%; right: 100%; transform: translateY(-50%); width: 3rem; margin-right: 1rem; text-align: right; font-size: 0.8rem; font-variant-numeric: tabular-nums; opacity: 0; pointer-events: none; }
  a:hover .year, a:focus-visible .year { opacity: 0.5; }
  .more { display: inline-block; margin-top: 2rem; padding-bottom: 2rem; color: var(--text); text-decoration: none; }
  .more:hover, .more:focus-visible { color: var(--accent-1); }
  @media (max-width: 700px) {
    :global(:root) { font-size: 112.5%; }
    .year { display: none; }
  }
</style>
