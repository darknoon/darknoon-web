---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/resources/wubba-lubba-dub-dub.jpg';
---
<Layout>
  <div class="portrait"><Image src={portrait} alt="Andrew Pouliot" width={300} widths={[300, 600]} sizes="300px" loading="eager" quality={90} /></div>
  <p>I am working on machine learning and realtime graphics for creative applications.</p>
  <p><a href="/projects/">Recent projects</a></p>
  <p>Old <a href="/cv/">iOS and Mac projects</a> and <a href="/old/">blog</a>.</p>
  <p><a href="http://twitter.com/andpoul">twitter</a> <a href="http://github.com/darknoon">github</a></p>
</Layout>
<style>.portrait { position: relative; } .portrait img { margin: 0; width: 300px; height: auto; }</style>
