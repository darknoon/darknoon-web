---
import Layout from '../../layouts/Layout.astro';

const sections = [
  { label: 'Work', items: [
    { year: 2026, name: 'Fieldwork', href: 'https://fieldwork.software/' },
    { year: 2024, name: 'Prefix Canvas', href: 'https://canvas.prefix.design/files/Colored%20Boxes' },
    { year: 2022, name: 'Diagram', href: 'https://www.figma.com/blog/ai-the-next-chapter-in-design/' },
    { year: 2017, name: 'Lobe', href: 'https://lobe.ai/' },
    { year: 2016, name: 'Origami Studio', href: 'https://origami.design' },
    { year: 2014, name: 'Facebook Paper', href: 'https://www.youtube.com/watch?v=Zq6-b9_V9lA' },
  ] },
  { label: 'Fun', items: [
    { year: 2026, name: 'Drawing Room', href: 'https://brush.tips/' },
    { year: 2020, name: 'GAN bending', href: '/2020/03/03/gan-hacking/' },
    { year: 2019, name: 'Statue of Liberty official app', href: 'https://apps.apple.com/us/story/id1464767766' },
    { year: 2018, name: 'Flower Petals', href: '/projects/#meyohas-petals' },
  ] },
];
---
<Layout title="Work/Fun label options">
  <h1>Section labels — same size</h1>
  <p class="note">All three keep the label at the list's font size. Only weight or color changes.</p>

  <section class="variant">
    <h2 class="variant-name">1 · Bold, same color</h2>
    {sections.map(({ label, items }) => (
      <div class="group opt-bold">
        <p class="label">{label}</p>
        <ul>{items.map(({ year, name, href }) => (
          <li><a href={href}><span class="year">{year}</span><span class="link-name">{name}</span></a></li>
        ))}</ul>
      </div>
    ))}
  </section>

  <section class="variant">
    <h2 class="variant-name">2 · Muted color, regular weight</h2>
    {sections.map(({ label, items }) => (
      <div class="group opt-muted">
        <p class="label">{label}</p>
        <ul>{items.map(({ year, name, href }) => (
          <li><a href={href}><span class="year">{year}</span><span class="link-name">{name}</span></a></li>
        ))}</ul>
      </div>
    ))}
  </section>

  <section class="variant">
    <h2 class="variant-name">3 · Accent color, regular weight</h2>
    {sections.map(({ label, items }) => (
      <div class="group opt-accent">
        <p class="label">{label}</p>
        <ul>{items.map(({ year, name, href }) => (
          <li><a href={href}><span class="year">{year}</span><span class="link-name">{name}</span></a></li>
        ))}</ul>
      </div>
    ))}
  </section>
</Layout>

<style>
  .note { color: var(--text-muted); max-width: 44rem; }
  .variant { margin: 2.5rem 0 4rem; }
  .variant-name { font-size: 0.9rem; font-weight: 600; margin: 0 0 1rem; color: var(--text-muted); }
  .group { margin-bottom: 1.5rem; }
  .group ul { list-style: none; margin: 0; padding: 0; }
  .group li { margin: 0; }
  .group a { position: relative; color: inherit; display: inline-flex; align-items: baseline; padding: 0.2rem 0; text-decoration: none; }
  .group a:hover .link-name { text-decoration: underline; }
  .group .year { flex: 0 0 3rem; margin-left: -4rem; margin-right: 1rem; text-align: right; font-size: 0.8rem; font-variant-numeric: tabular-nums; opacity: 0; pointer-events: none; }
  .group a:hover .year { opacity: 0.5; }

  /* Every label matches the list font size. */
  .group .label { font-size: inherit; line-height: 1.45; margin: 0 0 0.2rem; }
  .opt-bold .label { font-weight: 700; }
  .opt-muted .label { color: var(--text-muted); }
  .opt-accent .label { color: var(--accent-1); }
</style>
