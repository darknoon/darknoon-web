---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { postDetails } from '../data/posts';
const posts = (await getCollection('posts')).sort((a, b) => b.id.localeCompare(a.id));
---
<Layout title="Blog">
  <nav class="archive" aria-label="Blog posts">
    <ul>
      {posts.map(post => {
        const details = postDetails(post);
        return <li><a href={details.url}><span class="year">{details.year}</span><span class="link-name">{post.data.title}</span></a></li>;
      })}
    </ul>
  </nav>
</Layout>
<style>
  .archive { margin-top: 2rem; padding-bottom: 2rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 0; }
  a { position: relative; color: inherit; display: inline-flex; align-items: baseline; padding: 0.2rem 0; text-decoration: none; }
  a:hover .link-name { text-decoration: underline; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .year { flex: 0 0 3rem; margin-left: -4rem; margin-right: 1rem; text-align: right; font-size: 0.8rem; font-variant-numeric: tabular-nums; opacity: 0; pointer-events: none; }
  a:hover .year, a:focus-visible .year { opacity: 0.5; }
  @media (max-width: 1100px) {
    .archive { padding-left: 3.5rem; }
  }
</style>
